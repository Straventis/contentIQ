---
layout: base.njk
title: "Dashboard"
pageHeading: "Post Performance Dashboard"
---
<p class="page-meta-line"><span class="eyebrow-text">Content Intelligence</span><span class="meta-sep">&middot;</span><span class="subtitle-text" id="page-subtitle">Tracking {{ posts.length }} tagged posts across {{ dailyTotals.length }} days of data</span></p>

<div class="chart-controls">
  <div>
    <span class="control-label">Range</span>
    <div class="range-toggle" id="range-toggle-group">
      <button class="range-btn" data-range="7" type="button">7 days</button>
      <button class="range-btn" data-range="14" type="button">14 days</button>
      <button class="range-btn" data-range="28" type="button">28 days</button>
      <button class="range-btn active" data-range="all" type="button">All time</button>
      <button class="range-btn" data-range="custom" type="button">Custom</button>
    </div>
  </div>
  <div>
    <span class="control-label">View</span>
    <div class="range-toggle" id="mode-toggle-group">
      <button class="range-btn active" data-mode="daily" type="button">Daily</button>
      <button class="range-btn" data-mode="cumulative" type="button">Cumulative</button>
    </div>
  </div>
  <div>
    <span class="control-label">Chart</span>
    <div class="range-toggle" id="type-toggle-group">
      <button class="range-btn active" data-type="line" type="button">Line</button>
      <button class="range-btn" data-type="bar" type="button">Bar</button>
    </div>
  </div>
  <div>
    <span class="control-label">Update<span class="coming-soon-badge">Personal intervals coming soon</span></span>
    <div class="range-toggle" id="update-mode-group">
      <button class="range-btn" data-update-mode="manual" type="button">Manual</button>
      <button class="range-btn active" data-update-mode="auto" type="button">Auto</button>
    </div>
    <div id="update-interval-group">
      <div class="range-toggle" id="update-interval-toggle">
        <button class="range-btn" data-interval="1" type="button">1h</button>
        <button class="range-btn active" data-interval="4" type="button">4h</button>
        <button class="range-btn" data-interval="6" type="button">6h</button>
        <button class="range-btn" data-interval="12" type="button">12h</button>
        <button class="range-btn" data-interval="24" type="button">24h</button>
      </div>
      <p class="update-note">Data actually refreshes every 4h for everyone right now. Your pick here is saved as a personal preference for once account login launches.</p>
    </div>
    <div id="update-manual-group" class="hidden">
      <button class="range-btn" id="update-manual-btn" type="button">Refresh now</button>
    </div>
  </div>
</div>
<div class="custom-range-inputs" id="custom-range-inputs" style="display:none;">
  <input type="date" id="range-start">
  <span>to</span>
  <input type="date" id="range-end">
  <button type="button" id="apply-custom-range">Apply</button>
</div>

<div class="kpi-pillar-layout">
  <div class="kpi-left-col">
  <div class="kpi-grid-9">
    <div class="kpi-card">
      <p class="kpi-label">Total Impressions</p>
      <p class="kpi-value" id="kpi-total-impressions">&mdash;</p>
      <p class="kpi-trend" id="kpi-trend-impressions"></p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Total Engagements</p>
      <p class="kpi-value" id="kpi-total-engagements">&mdash;</p>
      <p class="kpi-trend" id="kpi-trend-engagements"></p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Posting Cadence</p>
      <p class="kpi-value" id="kpi-cadence">&mdash;</p>
      <p class="kpi-trend"></p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Avg Engagement Rate</p>
      <p class="kpi-value" id="kpi-rate-value">&mdash;</p>
      <p class="kpi-trend" id="kpi-trend-rate"></p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Avg Impressions / Post</p>
      <p class="kpi-value" id="kpi-avg-impressions">&mdash;</p>
      <p class="kpi-trend" id="kpi-trend-avg-impressions"></p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Best Day to Post</p>
      <p class="kpi-value" id="kpi-best-day">&mdash;</p>
      <p class="kpi-trend"></p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Avg Engagements / Post</p>
      <p class="kpi-value" id="kpi-avg-engagements">&mdash;</p>
      <p class="kpi-trend" id="kpi-trend-avg-engagements"></p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Comments : Reactions</p>
      <p class="kpi-value" id="kpi-comment-ratio">&mdash;</p>
      <p class="kpi-trend"></p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Top Content Type</p>
      <p class="kpi-value" id="kpi-top-type">&mdash;</p>
      <p class="kpi-trend"></p>
    </div>
  </div>
  </div>
  <div class="card chart-fill-card" style="margin-bottom:0;">
    <div class="card-header">
      <h2 style="margin:0;">Engagement Rate by Pillar</h2>
      <div style="display:flex; align-items:center; gap:8px;">
        <select class="metric-select" id="pillar-metric">
          <option value="engagementRate">Engagement Rate</option>
          <option value="impressions">Impressions</option>
          <option value="reactions">Reactions</option>
        </select>
        <button class="expand-btn" type="button" id="expand-pillar" title="Expand">&#9974;</button>
      </div>
    </div>
    <div class="chart-canvas-wrap chart-canvas-wrap-lg"><canvas id="pillarChart"></canvas></div>
  </div>
</div>

<div class="card">
  <h2>Growth Overview</h2>
  <p class="mini-metric-note">Follows the same Range / View / Chart controls above. Impressions and Engagement duplicate the numbers above by design, shown here in the same compact format as the reference dashboard. Follower Growth is new followers gained within the tracked window, not a lifetime total &mdash; no historical baseline exists before tracking started. Posts counts only posts falling within daily_totals.csv's tracked window, so it can undercount vs. the total tagged post count above if older posts predate that window. Profile Views isn't available in any current data source (see the new Profile Views tab for what's genuinely trackable), so it's omitted rather than faked.</p>
  <div class="mini-metric-grid">
    <div class="mini-metric-card">
      <div class="card-header" style="margin-bottom:8px;">
        <div class="mini-metric-head" style="flex:1;">
          <span class="mini-metric-value" id="mini-followers-value">&mdash;</span>
          <span class="mini-metric-label">Follower Growth</span>
        </div>
        <button class="expand-btn" type="button" id="expand-mini-followers" title="Expand">&#9974;</button>
      </div>
      <div class="chart-canvas-wrap chart-canvas-wrap-sm"><canvas id="miniFollowersChart"></canvas></div>
    </div>
    <div class="mini-metric-card">
      <div class="card-header" style="margin-bottom:8px;">
        <div class="mini-metric-head" style="flex:1;">
          <span class="mini-metric-value" id="mini-posts-value">&mdash;</span>
          <span class="mini-metric-label">Posts</span>
        </div>
        <button class="expand-btn" type="button" id="expand-mini-posts" title="Expand">&#9974;</button>
      </div>
      <div class="chart-canvas-wrap chart-canvas-wrap-sm"><canvas id="miniPostsChart"></canvas></div>
    </div>
    <div class="mini-metric-card">
      <div class="card-header" style="margin-bottom:8px;">
        <div class="mini-metric-head" style="flex:1;">
          <span class="mini-metric-value" id="mini-impressions-value">&mdash;</span>
          <span class="mini-metric-label">Impressions</span>
        </div>
        <button class="expand-btn" type="button" id="expand-mini-impressions" title="Expand">&#9974;</button>
      </div>
      <div class="chart-canvas-wrap chart-canvas-wrap-sm"><canvas id="miniImpressionsChart"></canvas></div>
    </div>
    <div class="mini-metric-card">
      <div class="card-header" style="margin-bottom:8px;">
        <div class="mini-metric-head" style="flex:1;">
          <span class="mini-metric-value" id="mini-engagement-value">&mdash;</span>
          <span class="mini-metric-label">Engagement</span>
        </div>
        <button class="expand-btn" type="button" id="expand-mini-engagement" title="Expand">&#9974;</button>
      </div>
      <div class="chart-canvas-wrap chart-canvas-wrap-sm"><canvas id="miniEngagementChart"></canvas></div>
    </div>
  </div>
</div>

<script>
  var posts = {{ posts | json | safe }};
  var daily = {{ dailyTotals | json | safe }};

  var styles = getComputedStyle(document.documentElement);
  var accent = styles.getPropertyValue('--accent').trim();
  var accentSoft = styles.getPropertyValue('--accent-soft').trim();
  var inkSoft = styles.getPropertyValue('--ink-soft').trim();
  var line = styles.getPropertyValue('--line').trim();
  // Axis tick label size -- scales with the text-size setting (S/M/L/XL),
  // floors at 11px so it never gets too small to read even at the smallest setting.
  var baseTickFontSize = Math.max(11, Math.round(parseFloat(styles.getPropertyValue('--content-font-size')) * 0.8));
  var tickFontSize = Math.round(baseTickFontSize * 1.25);
  var pillarTickFontSize = Math.round((baseTickFontSize + 3) * 1.25);
  var pillarAxisTitleSize = Math.round(14 * 1.25);
  var miniAxisTitleSize = Math.round(9 * 1.25);
  // Axis label color follows the page's own accent color (Settings >
  // Color), not the newer bar/line chart color scheme -- those are a
  // separate, independent concern from the site's overall theme color.
  var axisLabelColor = accent;

  function shortDate(dateStr){
    var d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  // ---------- Shared date-range filter ----------
  var currentRange = { value: 'all', start: null, end: null };
  var currentMode = 'daily';
  var currentType = 'line';

  function getStoredRange(){ try { return localStorage.getItem('contentiq-date-range'); } catch(e){ return null; } }
  function setStoredRange(v){ try { localStorage.setItem('contentiq-date-range', v); } catch(e){} }

  function inRangeFor(dateStr, rangeValue, customStart, customEnd){
    if (rangeValue === 'all') return true;
    var d = new Date(dateStr);
    if (rangeValue === 'custom') {
      if (!customStart || !customEnd) return true;
      return d >= new Date(customStart) && d <= new Date(customEnd);
    }
    var days = parseInt(rangeValue, 10);
    var cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - days);
    return d >= cutoff;
  }
  function inRange(dateStr){ return inRangeFor(dateStr, currentRange.value, currentRange.start, currentRange.end); }

  function filteredDaily(){ return daily.filter(function(d){ return inRange(d.date); }); }
  function filteredPosts(){ return posts.filter(function(p){ return inRange(p.date); }); }

  // Previous period = the immediately preceding window of the same length
  // as whatever's currently selected (7 days -> prior 7 days, 28 days ->
  // prior 28 days, custom -> a same-length window right before it). "All
  // time" has no meaningful prior period to compare against.
  function getPreviousPeriodBounds(){
    if (currentRange.value === 'all') return null;
    var days, curStart;
    if (currentRange.value === 'custom') {
      if (!currentRange.start || !currentRange.end) return null;
      curStart = new Date(currentRange.start);
      var curEnd = new Date(currentRange.end);
      days = Math.round((curEnd - curStart) / 86400000) + 1;
    } else {
      days = parseInt(currentRange.value, 10);
      curStart = new Date();
      curStart.setDate(curStart.getDate() - days);
    }
    var prevEnd = new Date(curStart);
    prevEnd.setDate(prevEnd.getDate() - 1);
    var prevStart = new Date(prevEnd);
    prevStart.setDate(prevStart.getDate() - days + 1);
    return { start: prevStart, end: prevEnd };
  }

  function inPreviousPeriod(dateStr, bounds){
    var d = new Date(dateStr);
    return d >= bounds.start && d <= bounds.end;
  }

  function filteredDailyPrior(bounds){ return daily.filter(function(d){ return inPreviousPeriod(d.date, bounds); }); }
  function filteredPostsPrior(bounds){ return posts.filter(function(p){ return inPreviousPeriod(p.date, bounds); }); }

  // Renders "vs X last period" + a colored delta pill. isPoint means the
  // metric is itself a percentage (engagement rate), so the delta is
  // expressed in percentage points rather than a relative percent change.
  function renderTrend(elId, current, prior, opts){
    opts = opts || {};
    var el = document.getElementById(elId);
    if (!el) return;
    if (prior == null) { el.innerHTML = ''; return; }

    function downClass(magnitude){ return magnitude > 5 ? 'kpi-trend-down-severe' : 'kpi-trend-down-mild'; }

    var priorText = opts.formatPrior ? opts.formatPrior(prior) : prior.toLocaleString();
    var pillClass, pillText;
    if (opts.isPoint) {
      var diffPts = (current - prior) * 100;
      if (Math.abs(diffPts) < 0.05) { pillClass = 'kpi-trend-flat'; pillText = '\u2014 flat'; }
      else { pillClass = diffPts > 0 ? 'kpi-trend-up' : downClass(Math.abs(diffPts)); pillText = (diffPts > 0 ? '\u25B2 ' : '\u25BC ') + Math.abs(diffPts).toFixed(1) + 'pt'; }
    } else {
      if (prior === 0) { el.innerHTML = ''; return; }
      var pct = ((current - prior) / prior) * 100;
      if (Math.abs(pct) < 0.5) { pillClass = 'kpi-trend-flat'; pillText = '\u2014 flat'; }
      else { pillClass = pct > 0 ? 'kpi-trend-up' : downClass(Math.abs(pct)); pillText = (pct > 0 ? '\u25B2 ' : '\u25BC ') + Math.abs(pct).toFixed(1) + '%'; }
    }
    el.innerHTML = '<span class="kpi-trend-prior">vs ' + priorText + ' last period</span><span class="kpi-trend-pill ' + pillClass + '">' + pillText + '</span>';
  }

  function cumulativeSeries(dailyArr, key){
    var running = 0;
    return dailyArr.map(function(d){ running += d[key]; return { date: d.date, value: running }; });
  }

  // ---------- Pillar chart: now respects the date range (previously always all-time) ----------
  var pillarChart = null;
  var PILLAR_METRIC_CONFIG = {
    engagementRate: { label: 'Avg Engagement Rate %', accumulate: function(sum, p){ return sum + p.engagementRate; }, finalize: function(total, count){ return (total / count * 100).toFixed(2); } },
    impressions:    { label: 'Avg Impressions / Post', accumulate: function(sum, p){ return sum + p.impressions; }, finalize: function(total, count){ return Math.round(total / count); } },
    reactions:      { label: 'Avg Reactions / Post', accumulate: function(sum, p){ return sum + p.reactions; }, finalize: function(total, count){ return (total / count).toFixed(1); } }
  };
  var currentPillarMetric = 'engagementRate';

  function buildPillarChart(rangeValue, customStart, customEnd, metric){
    metric = metric || currentPillarMetric;
    var cfg = PILLAR_METRIC_CONFIG[metric];
    var fp = posts.filter(function(p){ return inRangeFor(p.date, rangeValue, customStart, customEnd); });
    var pillarMap = {};
    fp.forEach(function(p){
      if (!p.pillar || !p.pillar.trim()) return; // skip untagged posts rather than show a blank bar
      if (!pillarMap[p.pillar]) pillarMap[p.pillar] = { total: 0, count: 0 };
      pillarMap[p.pillar].total = cfg.accumulate(pillarMap[p.pillar].total, p);
      pillarMap[p.pillar].count += 1;
    });
    // Ascending order -- plain string sort works correctly here since every
    // numbered pillar is "N.0 Name" with a single-digit N, so "1.0" < "2.0"
    // < ... < "7.0" sorts correctly as text. Unnumbered pillars (e.g.
    // "Straventis") sort after all numbered ones, since digits sort before
    // letters.
    var pillarLabels = Object.keys(pillarMap).sort();
    var pillarData = pillarLabels.map(function(k){ return cfg.finalize(pillarMap[k].total, pillarMap[k].count); });
    var scheme = window.ContentIQCharts.currentScheme();
    var pillarColors = scheme === 'ranked'
      ? window.ContentIQCharts.getRankedPaletteByValue(pillarData.map(Number))
      : window.ContentIQCharts.getCategoricalPalette(scheme, pillarLabels.length);
    return { labels: pillarLabels, data: pillarData, colors: pillarColors, label: cfg.label };
  }

  // Draws a small color square just below the x-axis, one per bar, in the
  // same color as that bar -- a compact legend attached directly to each
  // category label instead of a separate legend block.
  var pillarColorSquarePlugin = {
    id: 'pillarColorSquarePlugin',
    afterDraw: function(chart){
      var ctx = chart.ctx;
      var xAxis = chart.scales.x;
      var colors = chart.data.datasets[0].backgroundColor;
      var meta = chart.getDatasetMeta(0);
      meta.data.forEach(function(bar, i){
        var size = 8;
        var x = bar.x - size / 2;
        var y = xAxis.bottom + 4;
        ctx.save();
        ctx.fillStyle = colors[i];
        ctx.fillRect(x, y, size, size);
        ctx.restore();
      });
    }
  };

  function renderPillarChart(){
    var d = buildPillarChart(currentRange.value, currentRange.start, currentRange.end, currentPillarMetric);
    if (pillarChart) pillarChart.destroy();
    pillarChart = new Chart(document.getElementById('pillarChart'), {
      type: 'bar',
      plugins: [pillarColorSquarePlugin, window.ContentIQCharts.boundingBoxPlugin],
      data: { labels: d.labels, datasets: [{ label: d.label, data: d.data, backgroundColor: d.colors, borderRadius: 6, barPercentage: 0.5, categoryPercentage: 0.6 }] },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: line }, ticks: { color: axisLabelColor, maxTicksLimit: 6, font: { size: pillarTickFontSize } }, title: { display: true, text: d.label, color: axisLabelColor, font: { size: pillarAxisTitleSize } } },
          x: { grid: { display: false }, ticks: { color: axisLabelColor, font: { size: pillarTickFontSize }, padding: 16 }, title: { display: true, text: 'Pillar', color: axisLabelColor, font: { size: pillarAxisTitleSize } } }
        }
      }
    });
  }

  // ---------- KPI row ----------
  function updateKpis(){
    var fp = filteredPosts();
    var fd = filteredDaily();
    // Total Impressions/Engagements come from daily_totals.csv, the same
    // source the chart uses -- this is what actually happened during the
    // selected window, matching LinkedIn's own reported number. Summing
    // posts published *within* the window (the old approach) undercounts,
    // since it misses ongoing impressions on older posts still accruing
    // views during the window, and shortchanges recently-published posts
    // that haven't had time to accumulate their full total yet.
    var totalImpressions = fd.reduce(function(a, d){ return a + d.impressions; }, 0);
    var totalEngagements = fd.reduce(function(a, d){ return a + d.engagements; }, 0);
    // Rate and per-post averages stay post-based -- these are genuinely
    // about individual posts, not account-wide daily activity, so they
    // correctly use posts published within the window.
    var avgRate = fp.length ? fp.reduce(function(a, p){ return a + p.engagementRate; }, 0) / fp.length : 0;
    var avgImpressions = fp.length ? fp.reduce(function(a, p){ return a + p.impressions; }, 0) / fp.length : 0;
    var avgEngagements = fp.length ? fp.reduce(function(a, p){ return a + p.engagements; }, 0) / fp.length : 0;

    document.getElementById('kpi-total-impressions').textContent = totalImpressions.toLocaleString();
    document.getElementById('kpi-total-engagements').textContent = totalEngagements.toLocaleString();
    document.getElementById('kpi-rate-value').textContent = (avgRate * 100).toFixed(2) + '%';
    document.getElementById('kpi-avg-impressions').textContent = fp.length ? Math.round(avgImpressions).toLocaleString() : '\u2014';
    document.getElementById('kpi-avg-engagements').textContent = fp.length ? avgEngagements.toFixed(1) : '\u2014';

    var priorBounds = getPreviousPeriodBounds();
    if (priorBounds) {
      var pd = filteredDailyPrior(priorBounds);
      var pp = filteredPostsPrior(priorBounds);
      var priorImpressions = pd.reduce(function(a, d){ return a + d.impressions; }, 0);
      var priorEngagements = pd.reduce(function(a, d){ return a + d.engagements; }, 0);
      var priorRate = pp.length ? pp.reduce(function(a, p){ return a + p.engagementRate; }, 0) / pp.length : null;
      var priorAvgImpressions = pp.length ? pp.reduce(function(a, p){ return a + p.impressions; }, 0) / pp.length : null;
      var priorAvgEngagements = pp.length ? pp.reduce(function(a, p){ return a + p.engagements; }, 0) / pp.length : null;

      renderTrend('kpi-trend-impressions', totalImpressions, priorImpressions);
      renderTrend('kpi-trend-engagements', totalEngagements, priorEngagements);
      renderTrend('kpi-trend-rate', avgRate, priorRate, { isPoint: true, formatPrior: function(v){ return (v * 100).toFixed(2) + '%'; } });
      renderTrend('kpi-trend-avg-impressions', avgImpressions, priorAvgImpressions, { formatPrior: function(v){ return Math.round(v).toLocaleString(); } });
      renderTrend('kpi-trend-avg-engagements', avgEngagements, priorAvgEngagements, { formatPrior: function(v){ return v.toFixed(1); } });
    } else {
      ['kpi-trend-impressions','kpi-trend-engagements','kpi-trend-rate','kpi-trend-avg-impressions','kpi-trend-avg-engagements'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.innerHTML = '';
      });
    }

    updateSecondaryMetrics(fp);

    var subtitleEl = document.getElementById('page-subtitle');
    if (subtitleEl) {
      subtitleEl.textContent = currentRange.value === 'all'
        ? 'Tracking ' + fp.length + ' tagged posts across ' + daily.length + ' days of data'
        : 'Tracking ' + fp.length + ' tagged posts in the selected range';
    }
  }

  function updateSecondaryMetrics(fp){
    var cadenceEl = document.getElementById('kpi-cadence');
    var bestDayEl = document.getElementById('kpi-best-day');
    var ratioEl = document.getElementById('kpi-comment-ratio');
    var topTypeEl = document.getElementById('kpi-top-type');
    if (!cadenceEl) return;

    if (!fp.length) {
      cadenceEl.textContent = '\u2014'; bestDayEl.textContent = '\u2014';
      ratioEl.textContent = '\u2014'; topTypeEl.textContent = '\u2014';
      return;
    }

    // Posting cadence: posts per week over the selected window.
    var dates = fp.map(function(p){ return new Date(p.date).getTime(); });
    var spanDays = currentRange.value === 'all'
      ? Math.max(1, Math.round((Math.max.apply(null, dates) - Math.min.apply(null, dates)) / 86400000))
      : (currentRange.value === 'custom' ? Math.max(1, Math.round((new Date(currentRange.end) - new Date(currentRange.start)) / 86400000)) : parseInt(currentRange.value, 10));
    var perWeek = (fp.length / spanDays) * 7;
    cadenceEl.textContent = perWeek.toFixed(1) + '/wk';

    // Best day to post: day-of-week with the highest average engagement rate.
    var DAY_NAMES = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var byDay = {};
    fp.forEach(function(p){
      var dow = new Date(p.date).getDay();
      if (!byDay[dow]) byDay[dow] = { total: 0, count: 0 };
      byDay[dow].total += p.engagementRate;
      byDay[dow].count += 1;
    });
    var bestDow = null, bestAvg = -1;
    Object.keys(byDay).forEach(function(dow){
      var avg = byDay[dow].total / byDay[dow].count;
      if (avg > bestAvg) { bestAvg = avg; bestDow = dow; }
    });
    bestDayEl.textContent = bestDow !== null ? DAY_NAMES[bestDow] : '\u2014';

    // Comments : Reactions ratio, expressed as 1:X for readability.
    var totalComments = fp.reduce(function(a, p){ return a + p.comments; }, 0);
    var totalReactions = fp.reduce(function(a, p){ return a + p.reactions; }, 0);
    ratioEl.textContent = totalComments > 0 ? '1:' + (totalReactions / totalComments).toFixed(1) : (totalReactions > 0 ? '0:' + totalReactions : '\u2014');

    // Top content type by average engagement rate.
    var byType = {};
    fp.forEach(function(p){
      if (!p.contentType) return;
      if (!byType[p.contentType]) byType[p.contentType] = { total: 0, count: 0 };
      byType[p.contentType].total += p.engagementRate;
      byType[p.contentType].count += 1;
    });
    var bestType = null, bestTypeAvg = -1;
    Object.keys(byType).forEach(function(t){
      var avg = byType[t].total / byType[t].count;
      if (avg > bestTypeAvg) { bestTypeAvg = avg; bestType = t; }
    });
    topTypeEl.textContent = bestType || '\u2014';
  }

  // ---------- Growth Overview mini charts: now share the same range/mode/type controls ----------
  var MINI_METRICS = {
    followers: { key: 'newFollowers', label: 'New Followers', canvasId: 'miniFollowersChart', valueId: 'mini-followers-value' },
    impressions: { key: 'impressions', label: 'Impressions', canvasId: 'miniImpressionsChart', valueId: 'mini-impressions-value' },
    engagement: { key: 'engagements', label: 'Engagements', canvasId: 'miniEngagementChart', valueId: 'mini-engagement-value' }
  };

  function buildMiniDataset(metricKey, rangeValue, mode, customStart, customEnd){
    var fd = daily.filter(function(d){ return inRangeFor(d.date, rangeValue, customStart, customEnd); });
    var source = mode === 'cumulative' ? cumulativeSeries(fd, metricKey) : fd.map(function(d){ return { date: d.date, value: d[metricKey] }; });
    return {
      labels: source.map(function(d){ return shortDate(d.date); }),
      values: source.map(function(d){ return d.value; }),
      total: fd.reduce(function(a, d){ return a + d[metricKey]; }, 0)
    };
  }

  function buildPostsDataset(rangeValue, mode, customStart, customEnd){
    var fd = daily.filter(function(d){ return inRangeFor(d.date, rangeValue, customStart, customEnd); });
    var fp = posts.filter(function(p){ return inRangeFor(p.date, rangeValue, customStart, customEnd); });
    var postsByDate = {};
    fp.forEach(function(p){ postsByDate[p.date] = (postsByDate[p.date] || 0) + 1; });
    var running = 0;
    var source = fd.map(function(d){
      var count = postsByDate[d.date] || 0;
      if (mode === 'cumulative') { running += count; return { date: d.date, value: running }; }
      return { date: d.date, value: count };
    });
    return { labels: source.map(function(d){ return shortDate(d.date); }), values: source.map(function(d){ return d.value; }), total: fp.length };
  }

  var miniCharts = {};
  function buildMiniChart(canvasId, labels, values, valueEl, yLabel){
    if (miniCharts[canvasId]) miniCharts[canvasId].destroy();
    var schemeLineColor = window.ContentIQCharts.getLineColor(window.ContentIQCharts.currentScheme());
    miniCharts[canvasId] = new Chart(document.getElementById(canvasId), {
      type: currentType,
      plugins: [window.ContentIQCharts.boundingBoxPlugin],
      data: {
        labels: labels,
        datasets: [{
          data: values,
          borderColor: schemeLineColor,
          backgroundColor: currentType === 'bar' ? schemeLineColor : accentSoft,
          fill: currentType === 'line',
          tension: 0.25,
          pointRadius: 0,
          borderWidth: 2,
          borderRadius: currentType === 'bar' ? 3 : 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { color: axisLabelColor, font: { size: tickFontSize }, maxTicksLimit: 4 }, grid: { color: line }, title: { display: true, text: yLabel, color: axisLabelColor, font: { size: miniAxisTitleSize } } },
          x: { ticks: { color: axisLabelColor, font: { size: tickFontSize }, maxRotation: 0, autoSkip: true, maxTicksLimit: 6 }, grid: { display: false } }
        }
      }
    });
    var last = values.length ? values[values.length - 1] : 0;
    document.getElementById(valueEl).textContent = (currentMode === 'cumulative' ? last : values.reduce(function(a,b){return a+b;},0)).toLocaleString();
  }

  function buildMiniCharts(){
    var followers = buildMiniDataset('newFollowers', currentRange.value, currentMode, currentRange.start, currentRange.end);
    buildMiniChart('miniFollowersChart', followers.labels, followers.values, 'mini-followers-value', 'New Followers');

    var postsDs = buildPostsDataset(currentRange.value, currentMode, currentRange.start, currentRange.end);
    buildMiniChart('miniPostsChart', postsDs.labels, postsDs.values, 'mini-posts-value', 'Posts');
    document.getElementById('mini-posts-value').textContent = currentMode === 'cumulative' ? (postsDs.values.length ? postsDs.values[postsDs.values.length-1] : 0) : postsDs.total;

    var impressions = buildMiniDataset('impressions', currentRange.value, currentMode, currentRange.start, currentRange.end);
    buildMiniChart('miniImpressionsChart', impressions.labels, impressions.values, 'mini-impressions-value', 'Impressions');

    var engagement = buildMiniDataset('engagements', currentRange.value, currentMode, currentRange.start, currentRange.end);
    buildMiniChart('miniEngagementChart', engagement.labels, engagement.values, 'mini-engagement-value', 'Engagements');
  }

  // ---------- Wire up shared controls ----------
  (function(){
    var rangeButtons = document.querySelectorAll('#range-toggle-group .range-btn');
    var modeButtons = document.querySelectorAll('#mode-toggle-group .range-btn');
    var typeButtons = document.querySelectorAll('#type-toggle-group .range-btn');
    var customInputs = document.getElementById('custom-range-inputs');
    var startInput = document.getElementById('range-start');
    var endInput = document.getElementById('range-end');
    var applyCustomBtn = document.getElementById('apply-custom-range');

    function refresh(){
      updateKpis();
      buildMiniCharts();
      renderPillarChart();
    }

    function setRange(rangeValue, customStart, customEnd){
      currentRange.value = rangeValue;
      currentRange.start = customStart || null;
      currentRange.end = customEnd || null;
      rangeButtons.forEach(function(b){ b.classList.toggle('active', b.dataset.range === rangeValue); });
      customInputs.style.display = rangeValue === 'custom' ? 'flex' : 'none';
      if (rangeValue !== 'custom') setStoredRange(rangeValue);
      refresh();
    }

    rangeButtons.forEach(function(btn){ btn.addEventListener('click', function(){ setRange(btn.dataset.range); }); });
    applyCustomBtn.addEventListener('click', function(){ setRange('custom', startInput.value, endInput.value); });

    modeButtons.forEach(function(btn){
      btn.addEventListener('click', function(){
        currentMode = btn.dataset.mode;
        modeButtons.forEach(function(b){ b.classList.toggle('active', b === btn); });
        buildMiniCharts();
      });
    });

    typeButtons.forEach(function(btn){
      btn.addEventListener('click', function(){
        currentType = btn.dataset.type;
        typeButtons.forEach(function(b){ b.classList.toggle('active', b === btn); });
        buildMiniCharts();
      });
    });

    setRange(getStoredRange() || 'all');

    window.addEventListener('contentiq-chart-scheme-change', function(){ refresh(); });
  })();

  document.getElementById('pillar-metric').addEventListener('change', function(){
    currentPillarMetric = this.value;
    renderPillarChart();
  });

  // ---------- Expand-to-fullscreen wiring ----------
  document.getElementById('expand-pillar').addEventListener('click', function(){
    var titleMap = { engagementRate: 'Engagement Rate by Pillar', impressions: 'Impressions by Pillar', reactions: 'Reactions by Pillar' };
    ContentIQModal.open({
      title: titleMap[currentPillarMetric] || 'Engagement Rate by Pillar', hasControls: true, hasModeToggle: false, hasTypeToggle: false,
      defaultRange: currentRange.value === 'custom' ? 'all' : currentRange.value,
      onRender: function(canvas, range){
        var d = buildPillarChart(range, null, null, currentPillarMetric);
        return new Chart(canvas, {
          type: 'bar',
          plugins: [pillarColorSquarePlugin, window.ContentIQCharts.boundingBoxPlugin],
          data: { labels: d.labels, datasets: [{ label: d.label, data: d.data, backgroundColor: d.colors, borderRadius: 6, barPercentage: 0.5, categoryPercentage: 0.6 }] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, grid: { color: line }, ticks: { color: axisLabelColor, maxTicksLimit: 8, font: { size: pillarTickFontSize } }, title: { display: true, text: d.label, color: axisLabelColor, font: { size: pillarAxisTitleSize } } },
              x: { grid: { display: false }, ticks: { color: axisLabelColor, font: { size: pillarTickFontSize }, padding: 16 }, title: { display: true, text: 'Pillar', color: axisLabelColor, font: { size: pillarAxisTitleSize } } }
            } }
        });
      }
    });
  });

  function wireMiniExpand(buttonId, builder, label, yLabel){
    document.getElementById(buttonId).addEventListener('click', function(){
      ContentIQModal.open({
        title: label, hasControls: true, hasModeToggle: true, hasTypeToggle: true,
        defaultRange: currentRange.value === 'custom' ? 'all' : currentRange.value, defaultMode: currentMode, defaultType: currentType,
        onRender: function(canvas, range, mode, type){
          var ds = builder(range, mode);
          var schemeLineColor = window.ContentIQCharts.getLineColor(window.ContentIQCharts.currentScheme());
          return new Chart(canvas, {
            type: type,
            plugins: [window.ContentIQCharts.boundingBoxPlugin],
            data: { labels: ds.labels, datasets: [{ label: label, data: ds.values, borderColor: schemeLineColor, backgroundColor: type === 'bar' ? schemeLineColor : accentSoft, fill: type === 'line', tension: 0.25, borderWidth: 2, borderRadius: type === 'bar' ? 4 : 0 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
              scales: {
                y: { beginAtZero: true, grid: { color: line }, ticks: { color: axisLabelColor, maxTicksLimit: 8, font: { size: tickFontSize } }, title: { display: true, text: yLabel, color: axisLabelColor, font: { size: miniAxisTitleSize } } },
                x: { grid: { display: false }, ticks: { color: axisLabelColor, maxRotation: 0, font: { size: tickFontSize } }, title: { display: true, text: 'Date', color: axisLabelColor, font: { size: miniAxisTitleSize } } }
              } }
          });
        }
      });
    });
  }
  wireMiniExpand('expand-mini-followers', function(range, mode){ return buildMiniDataset('newFollowers', range, mode); }, 'Follower Growth', 'New Followers');
  wireMiniExpand('expand-mini-posts', function(range, mode){ return buildPostsDataset(range, mode); }, 'Posts', 'Posts');
  wireMiniExpand('expand-mini-impressions', function(range, mode){ return buildMiniDataset('impressions', range, mode); }, 'Impressions', 'Impressions');
  wireMiniExpand('expand-mini-engagement', function(range, mode){ return buildMiniDataset('engagements', range, mode); }, 'Engagement', 'Engagements');

  // ---------- Update control (Manual / Auto) -- UI shell only, coming soon ----------
  // Preference genuinely persists to localStorage today. The actual refresh
  // action does not run yet -- it requires a server-side trigger (GitHub
  // Actions workflow or a Worker proxy) since Buffer's API key can never
  // safely live in this page's client-side JS. See STRV-62.
  (function(){
    function getStored(key, fallback){ try { return localStorage.getItem(key) || fallback; } catch(e){ return fallback; } }
    function setStored(key, val){ try { localStorage.setItem(key, val); } catch(e){} }

    var modeButtons = document.querySelectorAll('#update-mode-group .range-btn');
    var intervalButtons = document.querySelectorAll('#update-interval-toggle .range-btn');
    var intervalGroup = document.getElementById('update-interval-group');
    var manualGroup = document.getElementById('update-manual-group');
    var manualBtn = document.getElementById('update-manual-btn');

    function applyMode(mode){
      modeButtons.forEach(function(b){ b.classList.toggle('active', b.dataset.updateMode === mode); });
      intervalGroup.classList.toggle('hidden', mode !== 'auto');
      manualGroup.classList.toggle('hidden', mode !== 'manual');
    }

    var savedMode = getStored('contentiq-update-mode', 'auto');
    var savedInterval = getStored('contentiq-update-interval', '4');
    applyMode(savedMode);
    intervalButtons.forEach(function(b){ b.classList.toggle('active', b.dataset.interval === savedInterval); });

    modeButtons.forEach(function(btn){
      btn.addEventListener('click', function(){
        var mode = btn.dataset.updateMode;
        setStored('contentiq-update-mode', mode);
        applyMode(mode);
        showUpdateToast(mode === 'auto' ? 'Auto mode saved — data refreshes every 4h for everyone' : 'Manual mode saved — see note below for how to trigger a real refresh');
      });
    });

    intervalButtons.forEach(function(btn){
      btn.addEventListener('click', function(){
        intervalButtons.forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        setStored('contentiq-update-interval', btn.dataset.interval);
        showUpdateToast('Saved as your preference (' + btn.dataset.interval + 'h) — real interval is still fixed at 4h for now');
      });
    });

    if (manualBtn) {
      manualBtn.addEventListener('click', function(){
        showUpdateToast('Trigger a real refresh from the repo Actions tab — see note below');
      });
    }
  })();
</script>
