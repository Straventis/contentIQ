---
layout: base.njk
title: "Dashboard"
---
<p class="eyebrow">Content Intelligence</p>
<h1 class="page-title">Post Performance Dashboard</h1>
<p class="subtitle" id="page-subtitle">Tracking {{ posts.length }} tagged posts across {{ dailyTotals.length }} days of data</p>

<div class="chart-controls">
  <div>
    <span class="control-label">Range</span>
    <div class="range-toggle" id="range-toggle-group">
      <button class="range-btn" data-range="7" type="button">7 days</button>
      <button class="range-btn" data-range="14" type="button">14 days</button>
      <button class="range-btn" data-range="30" type="button">30 days</button>
      <button class="range-btn active" data-range="all" type="button">All time</button>
      <button class="range-btn" data-range="custom" type="button">Custom</button>
    </div>
  </div>
  <div>
    <span class="control-label">View</span>
    <div class="range-toggle" id="mode-toggle-group">
      <button class="range-btn active" data-mode="daily" type="button">Daily</button>
      <button class="range-btn" data-mode="cumulative" type="button">Cumulative</button>
    </div>
  </div>
  <div>
    <span class="control-label">Chart</span>
    <div class="range-toggle" id="type-toggle-group">
      <button class="range-btn active" data-type="line" type="button">Line</button>
      <button class="range-btn" data-type="bar" type="button">Bar</button>
    </div>
  </div>
  <div>
    <span class="control-label">Update<span class="coming-soon-badge">Coming soon</span></span>
    <div class="range-toggle" id="update-mode-group">
      <button class="range-btn" data-update-mode="manual" type="button">Manual</button>
      <button class="range-btn active" data-update-mode="auto" type="button">Auto</button>
    </div>
    <div id="update-interval-group">
      <div class="range-toggle" id="update-interval-toggle">
        <button class="range-btn" data-interval="1" type="button">1h</button>
        <button class="range-btn active" data-interval="4" type="button">4h</button>
        <button class="range-btn" data-interval="6" type="button">6h</button>
        <button class="range-btn" data-interval="12" type="button">12h</button>
        <button class="range-btn" data-interval="24" type="button">24h</button>
      </div>
    </div>
    <div id="update-manual-group" class="hidden">
      <button class="range-btn" id="update-manual-btn" type="button">Refresh now</button>
    </div>
  </div>
</div>
<div class="custom-range-inputs" id="custom-range-inputs" style="display:none;">
  <input type="date" id="range-start">
  <span>to</span>
  <input type="date" id="range-end">
  <button type="button" id="apply-custom-range">Apply</button>
</div>

<div class="kpi-row">
  <div class="kpi-card">
    <p class="kpi-label">Total Impressions</p>
    <p class="kpi-value" id="kpi-total-impressions">&mdash;</p>
  </div>
  <div class="kpi-card">
    <p class="kpi-label">Total Engagements</p>
    <p class="kpi-value" id="kpi-total-engagements">&mdash;</p>
  </div>
  <div class="kpi-card">
    <p class="kpi-label">Avg Engagement Rate</p>
    <p class="kpi-value" id="kpi-rate-value">&mdash;</p>
  </div>
  <div class="kpi-card">
    <p class="kpi-label">Avg Impressions / Post</p>
    <p class="kpi-value" id="kpi-avg-impressions">&mdash;</p>
  </div>
  <div class="kpi-card">
    <p class="kpi-label">Avg Engagements / Post</p>
    <p class="kpi-value" id="kpi-avg-engagements">&mdash;</p>
  </div>
</div>

<div class="charts-row">
  <div class="card">
    <div class="card-header">
      <h2>Account Impressions Over Time</h2>
      <button class="expand-btn" type="button" id="expand-timeline" title="Expand">&#9974;</button>
    </div>
    <div class="chart-canvas-wrap chart-canvas-wrap-lg"><canvas id="timelineChart"></canvas></div>
  </div>
  <div class="card">
    <div class="card-header">
      <h2>Engagement Rate by Pillar</h2>
      <button class="expand-btn" type="button" id="expand-pillar" title="Expand">&#9974;</button>
    </div>
    <div class="chart-canvas-wrap chart-canvas-wrap-lg"><canvas id="pillarChart"></canvas></div>
  </div>
</div>

<div class="card">
  <h2>Growth Overview</h2>
  <p class="mini-metric-note">Follows the same Range / View / Chart controls above. Impressions and Engagement duplicate the numbers above by design, shown here in the same compact format as the reference dashboard. Follower Growth is new followers gained within the tracked window, not a lifetime total &mdash; no historical baseline exists before tracking started. Posts counts only posts falling within daily_totals.csv's tracked window, so it can undercount vs. the total tagged post count above if older posts predate that window. Profile Views isn't available in any current data source (see the new Profile Views tab for what's genuinely trackable), so it's omitted rather than faked.</p>
  <div class="mini-metric-grid">
    <div class="mini-metric-card">
      <div class="card-header" style="margin-bottom:8px;">
        <div class="mini-metric-head" style="flex:1;">
          <span class="mini-metric-value" id="mini-followers-value">&mdash;</span>
          <span class="mini-metric-label">Follower Growth</span>
        </div>
        <button class="expand-btn" type="button" id="expand-mini-followers" title="Expand">&#9974;</button>
      </div>
      <div class="chart-canvas-wrap chart-canvas-wrap-sm"><canvas id="miniFollowersChart"></canvas></div>
    </div>
    <div class="mini-metric-card">
      <div class="card-header" style="margin-bottom:8px;">
        <div class="mini-metric-head" style="flex:1;">
          <span class="mini-metric-value" id="mini-posts-value">&mdash;</span>
          <span class="mini-metric-label">Posts</span>
        </div>
        <button class="expand-btn" type="button" id="expand-mini-posts" title="Expand">&#9974;</button>
      </div>
      <div class="chart-canvas-wrap chart-canvas-wrap-sm"><canvas id="miniPostsChart"></canvas></div>
    </div>
    <div class="mini-metric-card">
      <div class="card-header" style="margin-bottom:8px;">
        <div class="mini-metric-head" style="flex:1;">
          <span class="mini-metric-value" id="mini-impressions-value">&mdash;</span>
          <span class="mini-metric-label">Impressions</span>
        </div>
        <button class="expand-btn" type="button" id="expand-mini-impressions" title="Expand">&#9974;</button>
      </div>
      <div class="chart-canvas-wrap chart-canvas-wrap-sm"><canvas id="miniImpressionsChart"></canvas></div>
    </div>
    <div class="mini-metric-card">
      <div class="card-header" style="margin-bottom:8px;">
        <div class="mini-metric-head" style="flex:1;">
          <span class="mini-metric-value" id="mini-engagement-value">&mdash;</span>
          <span class="mini-metric-label">Engagement</span>
        </div>
        <button class="expand-btn" type="button" id="expand-mini-engagement" title="Expand">&#9974;</button>
      </div>
      <div class="chart-canvas-wrap chart-canvas-wrap-sm"><canvas id="miniEngagementChart"></canvas></div>
    </div>
  </div>
</div>

<script>
  var posts = {{ posts | json | safe }};
  var daily = {{ dailyTotals | json | safe }};

  var styles = getComputedStyle(document.documentElement);
  var accent = styles.getPropertyValue('--accent').trim();
  var accentSoft = styles.getPropertyValue('--accent-soft').trim();
  var inkSoft = styles.getPropertyValue('--ink-soft').trim();
  var line = styles.getPropertyValue('--line').trim();
  // Axis tick label size -- scales with the text-size setting (S/M/L/XL),
  // floors at 11px so it never gets too small to read even at the smallest setting.
  var tickFontSize = Math.max(11, Math.round(parseFloat(styles.getPropertyValue('--content-font-size')) * 0.8));

  function shortDate(dateStr){
    var d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  // ---------- Shared date-range filter ----------
  var currentRange = { value: 'all', start: null, end: null };
  var currentMode = 'daily';
  var currentType = 'line';

  function getStoredRange(){ try { return localStorage.getItem('contentiq-date-range'); } catch(e){ return null; } }
  function setStoredRange(v){ try { localStorage.setItem('contentiq-date-range', v); } catch(e){} }

  function inRangeFor(dateStr, rangeValue, customStart, customEnd){
    if (rangeValue === 'all') return true;
    var d = new Date(dateStr);
    if (rangeValue === 'custom') {
      if (!customStart || !customEnd) return true;
      return d >= new Date(customStart) && d <= new Date(customEnd);
    }
    var days = parseInt(rangeValue, 10);
    var cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - days);
    return d >= cutoff;
  }
  function inRange(dateStr){ return inRangeFor(dateStr, currentRange.value, currentRange.start, currentRange.end); }

  function filteredDaily(){ return daily.filter(function(d){ return inRange(d.date); }); }
  function filteredPosts(){ return posts.filter(function(p){ return inRange(p.date); }); }

  function cumulativeSeries(dailyArr, key){
    var running = 0;
    return dailyArr.map(function(d){ running += d[key]; return { date: d.date, value: running }; });
  }

  // ---------- Pillar chart: now respects the date range (previously always all-time) ----------
  var pillarChart = null;
  function buildPillarChart(rangeValue, customStart, customEnd){
    var fp = posts.filter(function(p){ return inRangeFor(p.date, rangeValue, customStart, customEnd); });
    var pillarMap = {};
    fp.forEach(function(p){
      if (!pillarMap[p.pillar]) pillarMap[p.pillar] = { total: 0, count: 0 };
      pillarMap[p.pillar].total += p.engagementRate;
      pillarMap[p.pillar].count += 1;
    });
    var pillarLabels = Object.keys(pillarMap);
    var pillarData = pillarLabels.map(function(k){ return (pillarMap[k].total / pillarMap[k].count * 100).toFixed(2); });
    var pillarPalette = ['#3E5C55', '#2A5C7A', '#A5680A', '#7A3B5C', '#5F7A3E', '#8A5C3E', '#3E5C7A', '#7A5C3E'];
    var pillarColors = pillarLabels.map(function(_, i){ return pillarPalette[i % pillarPalette.length]; });
    return { labels: pillarLabels, data: pillarData, colors: pillarColors };
  }
  function renderPillarChart(){
    var d = buildPillarChart(currentRange.value, currentRange.start, currentRange.end);
    if (pillarChart) pillarChart.destroy();
    pillarChart = new Chart(document.getElementById('pillarChart'), {
      type: 'bar',
      data: { labels: d.labels, datasets: [{ label: 'Avg Engagement Rate %', data: d.data, backgroundColor: d.colors, borderRadius: 6 }] },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: line }, ticks: { color: inkSoft, maxTicksLimit: 6, font: { size: tickFontSize } }, title: { display: true, text: 'Avg Engagement Rate %', color: inkSoft, font: { size: 11 } } },
          x: { grid: { display: false }, ticks: { color: inkSoft, font: { size: tickFontSize } }, title: { display: true, text: 'Pillar', color: inkSoft, font: { size: 11 } } }
        }
      }
    });
  }

  // ---------- KPI row ----------
  function updateKpis(){
    var fp = filteredPosts();
    var totalImpressions = fp.reduce(function(a, p){ return a + p.impressions; }, 0);
    var totalEngagements = fp.reduce(function(a, p){ return a + p.engagements; }, 0);
    var avgRate = fp.length ? fp.reduce(function(a, p){ return a + p.engagementRate; }, 0) / fp.length : 0;
    var avgImpressions = fp.length ? totalImpressions / fp.length : 0;
    var avgEngagements = fp.length ? totalEngagements / fp.length : 0;

    document.getElementById('kpi-total-impressions').textContent = totalImpressions.toLocaleString();
    document.getElementById('kpi-total-engagements').textContent = totalEngagements.toLocaleString();
    document.getElementById('kpi-rate-value').textContent = (avgRate * 100).toFixed(2) + '%';
    document.getElementById('kpi-avg-impressions').textContent = fp.length ? Math.round(avgImpressions).toLocaleString() : '\u2014';
    document.getElementById('kpi-avg-engagements').textContent = fp.length ? avgEngagements.toFixed(1) : '\u2014';

    var subtitleEl = document.getElementById('page-subtitle');
    if (subtitleEl) {
      subtitleEl.textContent = currentRange.value === 'all'
        ? 'Tracking ' + fp.length + ' tagged posts across ' + daily.length + ' days of data'
        : 'Tracking ' + fp.length + ' tagged posts in the selected range';
    }
  }

  // ---------- Main timeline chart ----------
  function buildTimelineDataset(rangeValue, mode, customStart, customEnd){
    var fd = daily.filter(function(d){ return inRangeFor(d.date, rangeValue, customStart, customEnd); });
    var source = mode === 'cumulative'
      ? cumulativeSeries(fd, 'impressions').map(function(d){ return { date: d.date, impressions: d.value }; })
      : fd;
    return { labels: source.map(function(d){ return shortDate(d.date); }), values: source.map(function(d){ return d.impressions; }) };
  }
  var timelineChart = null;
  function buildTimelineChart(){
    var ds = buildTimelineDataset(currentRange.value, currentMode, currentRange.start, currentRange.end);
    if (timelineChart) timelineChart.destroy();
    timelineChart = new Chart(document.getElementById('timelineChart'), {
      type: currentType,
      data: { labels: ds.labels, datasets: [{ label: currentMode === 'cumulative' ? 'Cumulative Impressions' : 'Impressions', data: ds.values, borderColor: accent, backgroundColor: accent, tension: 0.3, fill: false, borderRadius: currentType === 'bar' ? 4 : 0 }] },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: line }, ticks: { color: inkSoft, maxTicksLimit: 6, font: { size: tickFontSize } }, title: { display: true, text: currentMode === 'cumulative' ? 'Cumulative Impressions' : 'Impressions', color: inkSoft, font: { size: 11 } } },
          x: { grid: { display: false }, ticks: { color: inkSoft, maxRotation: 0, autoSkip: true, font: { size: tickFontSize } }, title: { display: true, text: 'Date', color: inkSoft, font: { size: 11 } } }
        }
      }
    });
  }

  // ---------- Growth Overview mini charts: now share the same range/mode/type controls ----------
  var MINI_METRICS = {
    followers: { key: 'newFollowers', label: 'New Followers', canvasId: 'miniFollowersChart', valueId: 'mini-followers-value' },
    impressions: { key: 'impressions', label: 'Impressions', canvasId: 'miniImpressionsChart', valueId: 'mini-impressions-value' },
    engagement: { key: 'engagements', label: 'Engagements', canvasId: 'miniEngagementChart', valueId: 'mini-engagement-value' }
  };

  function buildMiniDataset(metricKey, rangeValue, mode, customStart, customEnd){
    var fd = daily.filter(function(d){ return inRangeFor(d.date, rangeValue, customStart, customEnd); });
    var source = mode === 'cumulative' ? cumulativeSeries(fd, metricKey) : fd.map(function(d){ return { date: d.date, value: d[metricKey] }; });
    return {
      labels: source.map(function(d){ return shortDate(d.date); }),
      values: source.map(function(d){ return d.value; }),
      total: fd.reduce(function(a, d){ return a + d[metricKey]; }, 0)
    };
  }

  function buildPostsDataset(rangeValue, mode, customStart, customEnd){
    var fd = daily.filter(function(d){ return inRangeFor(d.date, rangeValue, customStart, customEnd); });
    var fp = posts.filter(function(p){ return inRangeFor(p.date, rangeValue, customStart, customEnd); });
    var postsByDate = {};
    fp.forEach(function(p){ postsByDate[p.date] = (postsByDate[p.date] || 0) + 1; });
    var running = 0;
    var source = fd.map(function(d){
      var count = postsByDate[d.date] || 0;
      if (mode === 'cumulative') { running += count; return { date: d.date, value: running }; }
      return { date: d.date, value: count };
    });
    return { labels: source.map(function(d){ return shortDate(d.date); }), values: source.map(function(d){ return d.value; }), total: fp.length };
  }

  var miniCharts = {};
  function buildMiniChart(canvasId, labels, values, valueEl, yLabel){
    if (miniCharts[canvasId]) miniCharts[canvasId].destroy();
    miniCharts[canvasId] = new Chart(document.getElementById(canvasId), {
      type: currentType,
      data: {
        labels: labels,
        datasets: [{
          data: values,
          borderColor: accent,
          backgroundColor: currentType === 'bar' ? accent : accentSoft,
          fill: currentType === 'line',
          tension: 0.25,
          pointRadius: 0,
          borderWidth: 2,
          borderRadius: currentType === 'bar' ? 3 : 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { color: inkSoft, font: { size: tickFontSize }, maxTicksLimit: 4 }, grid: { color: line }, title: { display: true, text: yLabel, color: inkSoft, font: { size: 9 } } },
          x: { ticks: { color: inkSoft, font: { size: tickFontSize }, maxRotation: 0, autoSkip: true, maxTicksLimit: 6 }, grid: { display: false } }
        }
      }
    });
    var last = values.length ? values[values.length - 1] : 0;
    document.getElementById(valueEl).textContent = (currentMode === 'cumulative' ? last : values.reduce(function(a,b){return a+b;},0)).toLocaleString();
  }

  function buildMiniCharts(){
    var followers = buildMiniDataset('newFollowers', currentRange.value, currentMode, currentRange.start, currentRange.end);
    buildMiniChart('miniFollowersChart', followers.labels, followers.values, 'mini-followers-value', 'New Followers');

    var postsDs = buildPostsDataset(currentRange.value, currentMode, currentRange.start, currentRange.end);
    buildMiniChart('miniPostsChart', postsDs.labels, postsDs.values, 'mini-posts-value', 'Posts');
    document.getElementById('mini-posts-value').textContent = currentMode === 'cumulative' ? (postsDs.values.length ? postsDs.values[postsDs.values.length-1] : 0) : postsDs.total;

    var impressions = buildMiniDataset('impressions', currentRange.value, currentMode, currentRange.start, currentRange.end);
    buildMiniChart('miniImpressionsChart', impressions.labels, impressions.values, 'mini-impressions-value', 'Impressions');

    var engagement = buildMiniDataset('engagements', currentRange.value, currentMode, currentRange.start, currentRange.end);
    buildMiniChart('miniEngagementChart', engagement.labels, engagement.values, 'mini-engagement-value', 'Engagements');
  }

  // ---------- Wire up shared controls ----------
  (function(){
    var rangeButtons = document.querySelectorAll('#range-toggle-group .range-btn');
    var modeButtons = document.querySelectorAll('#mode-toggle-group .range-btn');
    var typeButtons = document.querySelectorAll('#type-toggle-group .range-btn');
    var customInputs = document.getElementById('custom-range-inputs');
    var startInput = document.getElementById('range-start');
    var endInput = document.getElementById('range-end');
    var applyCustomBtn = document.getElementById('apply-custom-range');

    function refresh(){
      buildTimelineChart();
      updateKpis();
      buildMiniCharts();
      renderPillarChart();
    }

    function setRange(rangeValue, customStart, customEnd){
      currentRange.value = rangeValue;
      currentRange.start = customStart || null;
      currentRange.end = customEnd || null;
      rangeButtons.forEach(function(b){ b.classList.toggle('active', b.dataset.range === rangeValue); });
      customInputs.style.display = rangeValue === 'custom' ? 'flex' : 'none';
      if (rangeValue !== 'custom') setStoredRange(rangeValue);
      refresh();
    }

    rangeButtons.forEach(function(btn){ btn.addEventListener('click', function(){ setRange(btn.dataset.range); }); });
    applyCustomBtn.addEventListener('click', function(){ setRange('custom', startInput.value, endInput.value); });

    modeButtons.forEach(function(btn){
      btn.addEventListener('click', function(){
        currentMode = btn.dataset.mode;
        modeButtons.forEach(function(b){ b.classList.toggle('active', b === btn); });
        buildTimelineChart();
        buildMiniCharts();
      });
    });

    typeButtons.forEach(function(btn){
      btn.addEventListener('click', function(){
        currentType = btn.dataset.type;
        typeButtons.forEach(function(b){ b.classList.toggle('active', b === btn); });
        buildTimelineChart();
        buildMiniCharts();
      });
    });

    setRange(getStoredRange() || 'all');
  })();

  // ---------- Expand-to-fullscreen wiring ----------
  document.getElementById('expand-timeline').addEventListener('click', function(){
    ContentIQModal.open({
      title: 'Account Impressions Over Time', hasControls: true, hasModeToggle: true, hasTypeToggle: true,
      defaultRange: currentRange.value === 'custom' ? 'all' : currentRange.value, defaultMode: currentMode, defaultType: currentType,
      onRender: function(canvas, range, mode, type){
        var ds = buildTimelineDataset(range, mode);
        return new Chart(canvas, {
          type: type,
          data: { labels: ds.labels, datasets: [{ label: mode === 'cumulative' ? 'Cumulative Impressions' : 'Impressions', data: ds.values, borderColor: accent, backgroundColor: accent, tension: 0.3, fill: false, borderRadius: type === 'bar' ? 4 : 0 }] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, grid: { color: line }, ticks: { color: inkSoft, maxTicksLimit: 8, font: { size: tickFontSize } }, title: { display: true, text: mode === 'cumulative' ? 'Cumulative Impressions' : 'Impressions', color: inkSoft } },
              x: { grid: { display: false }, ticks: { color: inkSoft, maxRotation: 0, font: { size: tickFontSize } }, title: { display: true, text: 'Date', color: inkSoft } }
            } }
        });
      }
    });
  });

  document.getElementById('expand-pillar').addEventListener('click', function(){
    ContentIQModal.open({
      title: 'Engagement Rate by Pillar', hasControls: true, hasModeToggle: false, hasTypeToggle: false,
      defaultRange: currentRange.value === 'custom' ? 'all' : currentRange.value,
      onRender: function(canvas, range){
        var d = buildPillarChart(range);
        return new Chart(canvas, {
          type: 'bar',
          data: { labels: d.labels, datasets: [{ label: 'Avg Engagement Rate %', data: d.data, backgroundColor: d.colors, borderRadius: 6 }] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, grid: { color: line }, ticks: { color: inkSoft, maxTicksLimit: 8, font: { size: tickFontSize } }, title: { display: true, text: 'Avg Engagement Rate %', color: inkSoft } },
              x: { grid: { display: false }, ticks: { color: inkSoft, font: { size: tickFontSize } }, title: { display: true, text: 'Pillar', color: inkSoft } }
            } }
        });
      }
    });
  });

  function wireMiniExpand(buttonId, builder, label, yLabel){
    document.getElementById(buttonId).addEventListener('click', function(){
      ContentIQModal.open({
        title: label, hasControls: true, hasModeToggle: true, hasTypeToggle: true,
        defaultRange: currentRange.value === 'custom' ? 'all' : currentRange.value, defaultMode: currentMode, defaultType: currentType,
        onRender: function(canvas, range, mode, type){
          var ds = builder(range, mode);
          return new Chart(canvas, {
            type: type,
            data: { labels: ds.labels, datasets: [{ label: label, data: ds.values, borderColor: accent, backgroundColor: type === 'bar' ? accent : accentSoft, fill: type === 'line', tension: 0.25, borderWidth: 2, borderRadius: type === 'bar' ? 4 : 0 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
              scales: {
                y: { beginAtZero: true, grid: { color: line }, ticks: { color: inkSoft, maxTicksLimit: 8, font: { size: tickFontSize } }, title: { display: true, text: yLabel, color: inkSoft } },
                x: { grid: { display: false }, ticks: { color: inkSoft, maxRotation: 0, font: { size: tickFontSize } }, title: { display: true, text: 'Date', color: inkSoft } }
              } }
          });
        }
      });
    });
  }
  wireMiniExpand('expand-mini-followers', function(range, mode){ return buildMiniDataset('newFollowers', range, mode); }, 'Follower Growth', 'New Followers');
  wireMiniExpand('expand-mini-posts', function(range, mode){ return buildPostsDataset(range, mode); }, 'Posts', 'Posts');
  wireMiniExpand('expand-mini-impressions', function(range, mode){ return buildMiniDataset('impressions', range, mode); }, 'Impressions', 'Impressions');
  wireMiniExpand('expand-mini-engagement', function(range, mode){ return buildMiniDataset('engagements', range, mode); }, 'Engagement', 'Engagements');

  // ---------- Update control (Manual / Auto) -- UI shell only, coming soon ----------
  // Preference genuinely persists to localStorage today. The actual refresh
  // action does not run yet -- it requires a server-side trigger (GitHub
  // Actions workflow or a Worker proxy) since Buffer's API key can never
  // safely live in this page's client-side JS. See STRV-62.
  (function(){
    function getStored(key, fallback){ try { return localStorage.getItem(key) || fallback; } catch(e){ return fallback; } }
    function setStored(key, val){ try { localStorage.setItem(key, val); } catch(e){} }

    var modeButtons = document.querySelectorAll('#update-mode-group .range-btn');
    var intervalButtons = document.querySelectorAll('#update-interval-toggle .range-btn');
    var intervalGroup = document.getElementById('update-interval-group');
    var manualGroup = document.getElementById('update-manual-group');
    var manualBtn = document.getElementById('update-manual-btn');

    function applyMode(mode){
      modeButtons.forEach(function(b){ b.classList.toggle('active', b.dataset.updateMode === mode); });
      intervalGroup.classList.toggle('hidden', mode !== 'auto');
      manualGroup.classList.toggle('hidden', mode !== 'manual');
    }

    var savedMode = getStored('contentiq-update-mode', 'auto');
    var savedInterval = getStored('contentiq-update-interval', '4');
    applyMode(savedMode);
    intervalButtons.forEach(function(b){ b.classList.toggle('active', b.dataset.interval === savedInterval); });

    modeButtons.forEach(function(btn){
      btn.addEventListener('click', function(){
        var mode = btn.dataset.updateMode;
        setStored('contentiq-update-mode', mode);
        applyMode(mode);
        showUpdateToast(mode === 'auto' ? 'Auto-update saved — live refresh coming soon' : 'Manual mode saved — live refresh coming soon');
      });
    });

    intervalButtons.forEach(function(btn){
      btn.addEventListener('click', function(){
        intervalButtons.forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        setStored('contentiq-update-interval', btn.dataset.interval);
        showUpdateToast('Refresh every ' + btn.dataset.interval + 'h saved — coming soon');
      });
    });

    if (manualBtn) {
      manualBtn.addEventListener('click', function(){
        showUpdateToast('Manual refresh coming soon — check back once account login is set up');
      });
    }
  })();
</script>
