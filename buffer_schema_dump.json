  "sample_linkedin_posts": [
    {
      "id": "6a6b8bd1d3da14bddd0c7134",
      "channelId": "6a5406f680cc80cdcaa81501",
      "channelService": "linkedin",
      "dueAt": "2026-07-30T17:37:21.863Z",
      "externalLink": "https://www.linkedin.com/feed/update/urn:li:share:7488649037634510849",
      "ideaId": null,
      "isCustomScheduled": false,
      "metricsUpdatedAt": null,
      "notificationStatus": null,
